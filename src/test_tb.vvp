S_0x641567afd540 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x641567afd6d0 .scope module, "test_tb" "test_tb" 3 3;
 .timescale -12 -12;
v0x641567b470e0_0 .net "boop", 31 0, v0x641567b37680_0;  1 drivers
v0x641567b471a0_0 .var "test", 31 0;
S_0x641567b37450 .scope module, "temp_test" "temp_test" 3 9, 4 3 0, S_0x641567afd6d0;
 .timescale -12 -12;
    .port_info 0 /INPUT 32 "test";
    .port_info 1 /OUTPUT 32 "boop";
v0x641567b37680_0 .var "boop", 31 0;
v0x641567b46fa0_0 .net "test", 31 0, v0x641567b471a0_0;  1 drivers
E_0x641567b36a60 .event anyedge, v0x641567b46fa0_0;
    .scope S_0x641567b37450;
T_0 ;
    %wait E_0x641567b36a60;
    %load/vec4 v0x641567b46fa0_0;
    %store/vec4 v0x641567b37680_0, 0, 32;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x641567afd6d0;
T_1 ;
    %pushi/vec4 2139095040, 0, 32;
    %store/vec4 v0x641567b471a0_0, 0, 32;
    %delay 1, 0;
    %vpi_call/w 3 17 "$display", "test=%h boop=%h", v0x641567b471a0_0, v0x641567b470e0_0 {0 0 0};
    %vpi_call/w 3 18 "$finish" {0 0 0};
    %end;
    .thread T_1;
